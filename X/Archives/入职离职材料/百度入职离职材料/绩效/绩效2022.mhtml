@keyframes heart-beat {=20
  0% { opacity: 1; }
  70% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes bounceInLeft {=20
  0%, 60%, 75%, 90%, 100% { animation-timing-function: cubic-bezier(0.215, =
0.61, 0.355, 1); }
  0% { opacity: 0; transform: translate3d(-3000px, 0px, 0px); }
  60% { opacity: 1; transform: translate3d(25px, 0px, 0px); }
  75% { transform: translate3d(-10px, 0px, 0px); }
  90% { transform: translate3d(5px, 0px, 0px); }
  100% { transform: translateZ(0px); }
}

@keyframes line-down {=20
  0% { bottom: 50%; left: 100%; width: 0px; }
  20% { bottom: 50%; left: 0px; width: 100%; }
  35% { bottom: 50%; left: 0px; width: 0px; }
  70% { bottom: 0px; left: 0px; width: 0px; }
  100% { bottom: 0px; left: 0px; width: 100%; }
}

@keyframes fade-in-out {=20
  0% { opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes row-in-out {=20
  0% { height: 0px; opacity: 0; }
  100% { height: 100%; opacity: 1; }
}

