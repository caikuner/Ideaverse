@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=3DInter:wght@100;200;=
300;400;500;600;700;800;900&display=3Dswap");

body { margin: 0px; font-size: 0.875rem; font-family: Inter, sans-serif; }

* { box-sizing: border-box; }

.container { padding: 7px; }

.heading { font-weight: bold; border-bottom: 1px solid rgb(221, 221, 221); =
padding-bottom: 3px; margin-bottom: 7px; color: rgb(32, 32, 32); }

.new-color-btn { background: white; border: 0px; cursor: pointer; display: =
flex; align-items: center; margin-bottom: 7px; margin-top: 7px; color: rgb(=
32, 32, 32); }

.color { display: grid; grid-template-columns: 1fr 22px 22px; margin-bottom=
: 7px; }

.color-action-btn { cursor: pointer; text-align: right; color: rgb(102, 102=
, 102); }

.color-action-btn:hover { color: rgb(32, 32, 32); }

.color-action-panel { padding: 7px; border-radius: 3px; border: 1px solid r=
gb(221, 221, 221); margin-bottom: 7px; }

.color-action-panel p.remove-warning { margin: 0px 0px 7px; font-style: ita=
lic; font-size: 0.785rem; color: rgb(32, 32, 32); }

.color-action-panel .btn { border: 0px; margin-top: 5px; cursor: pointer; b=
order-radius: 3px; background: rgb(238, 238, 238); }

.color-action-panel .close-btn { color: rgb(102, 102, 102); cursor: pointer=
; display: flex; align-items: center; }

.color-action-panel .close-btn:hover { color: rgb(32, 32, 32); }

.color-action-panel .update-btn:hover { background: rgb(221, 221, 221); }

.color-input-group { margin-bottom: 3px; display: flex; }

.color-input-group > .color-preview { width: 24px; height: 24px; border-rad=
ius: 3px; }

.color-input-group > .input { width: calc(100% - 30px); transform: translat=
eX(7px); border: 1px solid rgb(204, 204, 204); border-radius: 3px; }
