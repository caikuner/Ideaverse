{
  "command_timeout": 5,
  "templates_folder": "Atlas/Utilities/Templater",
  "templates_pairs": [
    [
      "",
      ""
    ]
  ],
  "trigger_on_file_creation": true,
  "auto_jump_to_cursor": false,
  "enable_system_commands": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "enable_folder_templates": false,
  "folder_templates": [
    {
      "folder": "+",
      "template": "Atlas/Utilities/Templates/+, Base.md"
    },
    {
      "folder": "Calendar",
      "template": "Atlas/Utilities/Templates/Calendar, Daily Note.md"
    },
    {
      "folder": "Efforts",
      "template": "Atlas/Utilities/Templates/Efforts, Base.md"
    },
    {
      "folder": "Atlas/Notes/Sources",
      "template": "Atlas/Utilities/Templates/Atlas, Source.md"
    }
  ],
  "enable_file_templates": false,
  "file_templates": [
    {
      "regex": ".*",
      "template": ""
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [
    ""
  ],
  "startup_templates": [
    ""
  ],
  "intellisense_render": 1
}